{{ if not .wsl }}
.chezmoiscripts/debian/wsl/**
.local/bin/xdg-open
{{ end }}

{{ if .github_actions }}
.chezmoiscripts/windows/install-wsl.ps1
.chezmoiscripts/chsh.sh
.chezmoiscripts/macos/set-preferences.sh
.chezmoiscripts/update-packages.sh
