{{ if and (ne .chezmoi.os "darwin") (ne .osbase "debian") }}
.chezmoiscripts/install-nix.sh
.chezmoiscripts/apply-nix-home-manager.sh
.chezmoiscripts/zz_cleanup-bootstrap.sh
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
.chezmoiscripts/macos/**
.config/karabiner/**
{{ end }}

{{ if ne .osbase "debian" }}
.chezmoiscripts/debian/**
.gnupg/**
{{ end }}

{{ if ne .chezmoi.os "windows" }}
.chezmoiscripts/windows/**
.config/komorebi/**
.config/whkdrc
.config/yasb/**
.local/bin/gh-ext.ps1
AppData/**
Documents/**
{{ else }}
.chezmoiscripts/*.sh
.config/bat/**
.config/home-manager/**
.config/mise/**
.config/nix/**
.config/nvim/**
.config/sops/**
.config/zsh/**
.krew/**
.local/bin/gh-ext
.local/share/tig/**
.local/share/zsh/**
.tool-versions
.zshenv
