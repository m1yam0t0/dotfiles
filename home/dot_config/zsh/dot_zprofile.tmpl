{{ if eq .chezmoi.os "darwin" -}}
# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"
# Prefer CLI tools managed by Home Manager over Homebrew and system tools.
export PATH="${HOME}/.nix-profile/bin:${PATH}"
{{ end -}}

{{- if .wsl -}}
# SSH Agent for WSL
# https://github.com/mame/wsl2-ssh-agent
eval "$($HOME/.local/bin/wsl2-ssh-agent)"
{{ end -}}
