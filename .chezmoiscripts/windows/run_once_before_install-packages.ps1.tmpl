# Check package installation
function Check-Winget-Package-Installation {
    param(
        [Parameter(Mandatory)][string]$package
    )

    # check package installation
    winget list $package | Out-Null
    if ($LastExitCode -ne 0) {
        return 0
    } else {
        Write-Host "$package has already installed."
        return 1
    }
}

# Install scoop
Write-Host 'Install packages via scoop'
if (Get-Command scoop -ErrorAction SilentlyContinue) {
    Write-Host 'scoop has already installed.'
} else {
    Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression
}

# Install Package via scoop
$scoopPackages =@(
    '1password-cli',
    'chezmoi',
    'delta',
    'fd',
    'gh',
    'mingit',
    'neovim',
    'ripgrep',
    'sudo'
)

foreach ( $package in $scoopPackages ) {
    scoop install $package
}

{{ if not .headless -}}
# Install Package via winget
Write-Host 'Install packages via winget'
$wingetPackages =@(
{{- if ne .chezmoi.hostname "mymt-desktop" -}}
    'tailscale.tailscale',
{{- end -}}
    '7zip.7zip',
    'AgileBits.1Password',
    'AmN.yasb',
    'Discord.Discord',
    'Google.JapaneseIME',
    'LGUG2Z.komorebi',
    'LGUG2Z.whkd',
    'Mozilla.Thunderbird',
    'Obsidian.Obsidian',
    'REALiX.HWiNFO',
    'SlackTechnologies.Slack',
    'StablyAI.Orca',
    'Synology.DriveClient',
    'Valve.Steam',
    'Vivaldi.Vivaldi',
    'Zoom.Zoom',
{{- /* MS Store Apps */ -}}
    'Apple Music',
    'LINE Desktop',
    'Raycast',
    '9PLM9XGG6VKS' # Codex
)

foreach ( $package in $wingetPackages ) {
    if ((Check-Winget-Package-Installation($package)) -eq 0) {
        winget install -e --id $package
    }
}
{{ end -}}
